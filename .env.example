# Copie este arquivo para ".env" e ajuste se precisar.
# NUNCA suba o .env de verdade pro Git (ele já está no .gitignore).

# --- Banco de dados ---
# Essa URL bate com o que definimos no docker-compose.yml
DATABASE_URL="postgresql://agendamentos:agendamentos123@localhost:5432/agendamentos_db?schema=public"

# --- Redis (fila) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Autenticação ---
# Em produção, gere segredos fortes (ex: openssl rand -hex 32)
JWT_ACCESS_SECRET=troque_esse_segredo_de_acesso
JWT_REFRESH_SECRET=troque_esse_segredo_de_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Servidor ---
PORT=3000
NODE_ENV=development
